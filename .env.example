# Server Configuration
PORT=3000

# Admin Authentication (Change these credentials in production!)
ADMIN_USERNAME=ankit kumar
ADMIN_PASSWORD=Ankit@8757
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Optional: Supabase Configuration (for production PostgreSQL database)
# Leave empty to use local SQLite database
# To use Supabase:
# 1. Create a Supabase project at https://supabase.com
# 2. Get the Project URL and Service Role Key
# 3. Create a 'messages' table with schema matching SQLite version
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Email Notifications
# Configure email service to send admin notifications on new messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
EMAIL_FROM_NAME=Portfolio Contact Form

# Rate Limiting (submissions per minute per IP)
# RATE_LIMIT_WINDOW=60000
# MAX_SUBMISSIONS_PER_WINDOW=5

# Security
# ENABLE_HONEYPOT=true
# CORS_ORIGIN=*
